#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")"
command_name="${1:-help}"
if [ "$command_name" = setup ]; then
  chosen_python="${TRACKER_PYTHON:-}"
  if [ -z "$chosen_python" ]; then
    for candidate in /opt/homebrew/bin/python3.13 /opt/homebrew/bin/python3.12 python3; do
      if "$candidate" -c 'import sys; sys.exit(sys.version_info < (3,12))' 2>/dev/null; then
        chosen_python="$candidate"
        break
      fi
    done
  fi
  if [ -z "$chosen_python" ]; then
    echo 'Python 3.12+ required. Set TRACKER_PYTHON to its executable.' >&2
    exit 1
  fi
  if [ ! -x .venv/bin/python ]; then "$chosen_python" -m venv .venv; fi
  .venv/bin/python -m pip install -r requirements-local.txt
  mkdir -p .local/bin
  if [ "$(uname -s)" = Darwin ] && command -v swiftc >/dev/null; then
    swiftc scripts/vision.swift -o .local/bin/vision-ocr
  fi
  exec .venv/bin/python -m tracker.local doctor
fi
if [ ! -x .venv/bin/python ]; then echo 'Run ./trackerctl setup first' >&2; exit 1; fi
shift || true
case "$command_name" in
  test) exec .venv/bin/python -m unittest discover -s tests -v "$@" ;;
  collect) exec .venv/bin/python -u -m tracker "$@" ;;
  doctor|restore|report|schedule|scheduled-run|publish) exec .venv/bin/python -m tracker.local "$command_name" "$@" ;;
  *) echo 'Usage: ./trackerctl {setup|doctor|restore|test|collect|report|schedule|publish}' ;;
esac
